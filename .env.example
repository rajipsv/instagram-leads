# Copy to .env and fill in. .env is git-ignored.

# Neon Postgres. Neon console -> Connection Details -> "Connection string" (keep sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# CampaignForge (Phase 2, optional). Workspace API key from CampaignForge Settings.
CF_API_URL=https://campaignforge-api.fly.dev
CF_API_KEY=

# Default business profile used when -b/--business is omitted (optional)
DEFAULT_BUSINESS=tutorsala
